# Dementia Risk Prediction

## Load Disease Prediction Model

```{python}
#| label: load-diagnosis-model
#| echo: true
#| eval: false

# Initialize diagnosis model
diagnosis_model = DiagnosisFinetuneFullLSTMCOXPHWithDemo(
    embed_dim=CONFIG['embed_dim'],
    num_classes=1065,  # Total number of diseases
    hidden_dim=256,
    num_lstm_layers=2,
    dropout=0.1
).to(device)

# Load checkpoint
checkpoint_diag = torch.load(CHECKPOINT_DIAGNOSIS / "best_model.pt", map_location=device)
diagnosis_model.load_state_dict(checkpoint_diag['model_state_dict'])
diagnosis_model.eval()

print("Diagnosis model loaded successfully!")
print(f"Model parameters: {sum(p.numel() for p in diagnosis_model.parameters()) / 1e6:.2f}M")
print(f"Number of disease classes: 1065")
```

## Load Label Mapping

```{python}
#| label: load-labels
#| echo: true

# Load disease label mapping
labels_df = pd.read_csv(LABEL_MAPPING)
print(f"Total diseases: {len(labels_df)}")

# Find dementia-related conditions
dementia_labels = labels_df[labels_df['phenotype'].str.contains('dementia|alzheimer', case=False, na=False)]
print(f"\nDementia-related conditions ({len(dementia_labels)}):")
print(dementia_labels[['label_idx', 'phecode', 'phenotype']].to_string(index=False))

# Primary dementia label (Phecode 290.0)
DEMENTIA_IDX = labels_df[labels_df['phecode'] == '290.0'].iloc[0]['label_idx']
print(f"\nPrimary dementia label index: {DEMENTIA_IDX}")
```

## Predict Dementia Risk

```{python}
#| label: predict-dementia
#| echo: true
#| eval: false

def predict_disease_risk(embeddings, demographics, model, device):
    """
    Predict hazard ratios for all 1,065 diseases

    Args:
        embeddings: (num_epochs, embed_dim) numpy array
        demographics: dict with 'age' and 'gender' (0=female, 1=male)
        model: diagnosis model
        device: torch device

    Returns:
        hazard_logits: (1065,) numpy array of log hazard ratios
    """
    # Prepare inputs
    emb_tensor = torch.FloatTensor(embeddings).unsqueeze(0).to(device)  # (1, num_epochs, embed_dim)

    # Create mask (all epochs are valid)
    mask = torch.ones(1, embeddings.shape[0], dtype=torch.bool).to(device)

    # Demographics tensor
    demo_tensor = torch.FloatTensor([[demographics['age'], demographics['gender']]]).to(device)

    # Forward pass
    with torch.no_grad():
        outputs = model(emb_tensor, mask, demo_tensor)

    return outputs.cpu().numpy()[0]

# Example prediction
if 'embeddings' in locals():
    # Example demographics
    patient_demographics = {
        'age': 65,  # years
        'gender': 1  # 1=male, 0=female
    }

    # Predict
    hazard_logits = predict_disease_risk(embeddings, patient_demographics, diagnosis_model, device)

    # Extract dementia risk
    dementia_hazard = hazard_logits[DEMENTIA_IDX]
    dementia_risk_ratio = np.exp(dementia_hazard)

    print(f"\n{'='*60}")
    print(f"DEMENTIA RISK PREDICTION")
    print(f"{'='*60}")
    print(f"Patient: {patient_demographics['age']} years, {'Male' if patient_demographics['gender'] == 1 else 'Female'}")
    print(f"Log Hazard Ratio: {dementia_hazard:.4f}")
    print(f"Hazard Ratio: {dementia_risk_ratio:.4f}")
    print(f"Interpretation: {dementia_risk_ratio:.2f}x relative risk vs. baseline")
    print(f"{'='*60}")
```

