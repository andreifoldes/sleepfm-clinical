# Results Visualization

## Top Disease Risks

```{python}
#| label: visualize-top-risks
#| echo: true
#| eval: false
#| fig-cap: "Top 20 predicted disease risks for the sample patient"

if 'hazard_logits' in locals():
    # Create results dataframe
    results_df = labels_df.copy()
    results_df['hazard_logit'] = hazard_logits
    results_df['hazard_ratio'] = np.exp(hazard_logits)

    # Sort by risk
    results_df = results_df.sort_values('hazard_ratio', ascending=False)

    # Top 20 risks
    top_risks = results_df.head(20)

    # Plot
    fig, ax = plt.subplots(figsize=(12, 8))

    colors = ['red' if 'dementia' in pheno.lower() or 'alzheimer' in pheno.lower()
              else 'steelblue' for pheno in top_risks['phenotype']]

    ax.barh(range(len(top_risks)), top_risks['hazard_ratio'], color=colors, alpha=0.7)
    ax.set_yticks(range(len(top_risks)))
    ax.set_yticklabels(top_risks['phenotype'], fontsize=9)
    ax.set_xlabel('Hazard Ratio (Relative Risk)', fontsize=12)
    ax.set_title('Top 20 Predicted Disease Risks from PSG Analysis', fontsize=14, fontweight='bold')
    ax.axvline(x=1.0, color='black', linestyle='--', linewidth=1, alpha=0.5, label='Baseline risk')
    ax.legend()
    ax.grid(axis='x', alpha=0.3)

    plt.tight_layout()
    plt.show()

    # Print table
    print("\nTop 20 Disease Risks:")
    print(top_risks[['phecode', 'phenotype', 'hazard_ratio']].to_string(index=False))
```

## Dementia Risk Distribution

```{python}
#| label: visualize-dementia-distribution
#| echo: true
#| eval: false
#| fig-cap: "Distribution of dementia hazard ratios across all diseases"

if 'hazard_logits' in locals():
    fig, axes = plt.subplots(1, 2, figsize=(14, 5))

    # Histogram of all hazards
    axes[0].hist(results_df['hazard_ratio'], bins=50, color='steelblue', alpha=0.7, edgecolor='black')
    axes[0].axvline(x=dementia_risk_ratio, color='red', linestyle='--', linewidth=2,
                    label=f'Dementia (HR={dementia_risk_ratio:.2f})')
    axes[0].set_xlabel('Hazard Ratio', fontsize=11)
    axes[0].set_ylabel('Number of Diseases', fontsize=11)
    axes[0].set_title('Distribution of Disease Hazard Ratios', fontsize=12, fontweight='bold')
    axes[0].legend()
    axes[0].grid(alpha=0.3)

    # Percentile rank
    percentile = (results_df['hazard_ratio'] < dementia_risk_ratio).sum() / len(results_df) * 100

    axes[1].bar(['Dementia Risk'], [dementia_risk_ratio], color='red', alpha=0.7, width=0.5)
    axes[1].axhline(y=1.0, color='black', linestyle='--', linewidth=1, alpha=0.5, label='Baseline')
    axes[1].set_ylabel('Hazard Ratio', fontsize=11)
    axes[1].set_title(f'Dementia Risk\n(Percentile: {percentile:.1f}th)', fontsize=12, fontweight='bold')
    axes[1].legend()
    axes[1].grid(axis='y', alpha=0.3)

    plt.tight_layout()
    plt.show()
```

