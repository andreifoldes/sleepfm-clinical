# Environment Setup

## Dependencies

```{python}
#| label: setup
#| echo: true

import sys
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import torch
import h5py
from pathlib import Path
import warnings
warnings.filterwarnings('ignore')

# Add sleepfm to path
sys.path.insert(0, '/home/user/sleepfm-clinical')

from sleepfm.preprocessing.preprocessing import EDFToHDF5Converter
from sleepfm.models.models import SetTransformer, DiagnosisFinetuneFullLSTMCOXPHWithDemo
from sleepfm.utils import load_checkpoint

# Set random seeds for reproducibility
np.random.seed(42)
torch.manual_seed(42)

# Device configuration
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")
    print(f"Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB")

# Configure plot style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (12, 6)
plt.rcParams['font.size'] = 10
```

## Model Configuration

```{python}
#| label: config
#| echo: true

# Paths
BASE_DIR = Path("/home/user/sleepfm-clinical")
DATA_DIR = BASE_DIR / "data"
CHECKPOINT_BASE = BASE_DIR / "sleepfm/checkpoints/model_base"
CHECKPOINT_DIAGNOSIS = BASE_DIR / "sleepfm/checkpoints/model_diagnosis"
LABEL_MAPPING = BASE_DIR / "sleepfm/configs/label_mapping.csv"

# Model hyperparameters
CONFIG = {
    'embed_dim': 128,
    'num_heads': 8,
    'num_encoder_layers': 6,
    'num_modalities': 4,  # BAS, RESP, EKG, EMG
    'sampling_rate': 128,  # Hz
    'epoch_duration': 300,  # seconds (5 minutes)
    'max_seq_length': 6480,  # ~540 minutes per night
}

print("Configuration loaded successfully!")
print(f"Embedding dimension: {CONFIG['embed_dim']}")
print(f"Number of modalities: {CONFIG['num_modalities']}")
```

---

# Data Preprocessing

## EDF to HDF5 Conversion

PSG files are typically stored in European Data Format (EDF). We convert them to HDF5 for efficient processing.

```{python}
#| label: preprocessing
#| echo: true
#| eval: false

# Initialize converter
converter = EDFToHDF5Converter(
    root_dir=str(DATA_DIR / "shhs/polysomnography/edfs"),
    target_dir=str(DATA_DIR / "shhs/processed"),
    resample_rate=CONFIG['sampling_rate'],
    num_threads=4
)

# Convert all EDF files
print("Starting EDF to HDF5 conversion...")
converter.convert_all_multiprocessing()
print("Conversion complete!")
```

::: {.callout-tip}
## Processing Details

- **Resampling**: All channels resampled to 128 Hz
- **Normalization**: Z-score standardization per channel
- **Compression**: gzip compression (level 4) for efficient storage
- **Chunking**: 5-minute epochs (38,400 samples @ 128 Hz)
:::

## Data Inspection

```{python}
#| label: inspect-data
#| echo: true
#| eval: false

# Load a processed HDF5 file
sample_file = DATA_DIR / "shhs/processed/shhs1-000001.h5"

if sample_file.exists():
    with h5py.File(sample_file, 'r') as f:
        print("Available channels:")
        for key in f.keys():
            data = f[key][:]
            duration_minutes = len(data) / (CONFIG['sampling_rate'] * 60)
            print(f"  {key}: {data.shape} ({duration_minutes:.1f} minutes)")

        # Extract metadata
        recording_duration = len(f[list(f.keys())[0]]) / (CONFIG['sampling_rate'] * 60)
        num_epochs = int(recording_duration / (CONFIG['epoch_duration'] / 60))

        print(f"\nRecording duration: {recording_duration:.1f} minutes")
        print(f"Number of 5-minute epochs: {num_epochs}")
else:
    print(f"Sample file not found: {sample_file}")
    print("Using demo data instead...")
```

