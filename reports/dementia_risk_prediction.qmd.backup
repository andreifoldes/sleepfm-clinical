# Embedding Generation

## Load Pre-trained Base Model

```{python}
#| label: load-base-model
#| echo: true
#| eval: false

# Initialize base model
base_model = SetTransformer(
    embed_dim=CONFIG['embed_dim'],
    num_heads=CONFIG['num_heads'],
    num_encoder_layers=CONFIG['num_encoder_layers'],
    num_modalities=CONFIG['num_modalities']
).to(device)

# Load checkpoint
checkpoint = torch.load(CHECKPOINT_BASE / "best_model.pt", map_location=device)
base_model.load_state_dict(checkpoint['model_state_dict'])
base_model.eval()

print("Base model loaded successfully!")
print(f"Model parameters: {sum(p.numel() for p in base_model.parameters()) / 1e6:.2f}M")
```

## Generate Embeddings

```{python}
#| label: generate-embeddings
#| echo: true
#| eval: false

def generate_embeddings(hdf5_path, model, device, config):
    """
    Generate 128-dim embeddings for each 5-minute epoch

    Returns:
        embeddings: (num_epochs, embed_dim) numpy array
        modality_embeddings: dict of (num_epochs, embed_dim) per modality
    """
    with h5py.File(hdf5_path, 'r') as f:
        # Load all channels
        channels = {key: f[key][:] for key in f.keys()}

    # Group channels by modality (simplified - actual grouping from channel_groups.json)
    modality_groups = {
        'BAS': [k for k in channels.keys() if any(x in k.upper() for x in ['EEG', 'C3', 'C4', 'F3', 'F4', 'O1', 'O2'])],
        'RESP': [k for k in channels.keys() if any(x in k.upper() for x in ['RESP', 'THOR', 'ABDO', 'AIRFLOW'])],
        'EKG': [k for k in channels.keys() if any(x in k.upper() for x in ['ECG', 'EKG'])],
        'EMG': [k for k in channels.keys() if any(x in k.upper() for x in ['EMG', 'CHIN', 'LEG'])]
    }

    # Create epochs
    epoch_samples = config['sampling_rate'] * config['epoch_duration']
    num_epochs = min([len(channels[k]) for k in channels.keys()]) // epoch_samples

    all_embeddings = []

    with torch.no_grad():
        for epoch_idx in range(num_epochs):
            start_idx = epoch_idx * epoch_samples
            end_idx = start_idx + epoch_samples

            # Extract epoch data for each modality
            modality_data = {}
            for mod_name, channel_list in modality_groups.items():
                if channel_list:
                    mod_data = np.stack([channels[ch][start_idx:end_idx] for ch in channel_list])
                    modality_data[mod_name] = torch.FloatTensor(mod_data).unsqueeze(0).to(device)

            # Generate embedding
            embedding = model(modality_data)
            all_embeddings.append(embedding.cpu().numpy())

    return np.vstack(all_embeddings)

# Generate embeddings for sample file
if sample_file.exists():
    embeddings = generate_embeddings(sample_file, base_model, device, CONFIG)
    print(f"Generated embeddings shape: {embeddings.shape}")

    # Save embeddings
    embeddings_path = DATA_DIR / "shhs/embeddings/shhs1-000001_embeddings.npy"
    embeddings_path.parent.mkdir(parents=True, exist_ok=True)
    np.save(embeddings_path, embeddings)
    print(f"Embeddings saved to {embeddings_path}")
```

